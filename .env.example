# 生产环境必填
MYSQL_PASSWORD=please-change-to-a-strong-password
SECRET_KEY=please-change-to-a-long-random-secret

# DeepSeek 配置（对话大模型）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Embedding 配置（RAG 检索用）：DeepSeek 官方无 embedding 接口，
# 默认走硅基流动的 BGE 系列，OpenAI 兼容格式，有免费额度
EMBEDDING_API_KEY=your-siliconflow-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 允许跨域的前端地址；同域部署时也可只保留本机调试地址
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://your-domain.com

# 图片地址前缀，通常留空表示和前端同域
VITE_FILE_BASE_URL=

# 对外访问端口
PORT=80

# 可选参数
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
